{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "swati-desai-avatar\\.vercel\\.app"
        }
      ],
      "destination": "https://swati-avatar-frontend.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "swati-avatar-admin\\.vercel\\.app"
        }
      ],
      "destination": "https://swati-desai-avatar-admin.vercel.app/:path*",
      "permanent": true
    }
  ]
}
